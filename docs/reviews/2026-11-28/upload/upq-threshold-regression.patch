+    fn upload_queue_threshold_reads_the_setting() {
+        const EXPECTED: &str = "VICTORY_TEST_UPLOAD_QUEUE_BYTES";
+        if let Ok(expected) = std::env::var(EXPECTED) {
+            let bytes = if expected == "off" { None } else { Some(expected.parse::<u64>().unwrap()) };
+            assert_eq!(threshold(), bytes);
+            return;
+        }
+
+        // Read the actual OnceLock in a fresh process for each setting.
+        for (asked, expected) in [
+            (None, "off"), (Some("0"), "off"), (Some("1"), "0"), (Some("4"), "4194304"),
+            (Some("-1"), "off"), (Some("bad"), "off"),
+            (Some("17592186044415"), "18446744073708503040"), // largest whole MiB in u64
+            (Some("17592186044416"), "off"), (Some("18446744073709551615"), "off"),
+        ] {
+            let mut cmd = std::process::Command::new(std::env::current_exe().unwrap());
+            cmd.env_remove("VICTORY_UPLOAD_QUEUE");
+            if let Some(value) = asked {
+                cmd.env("VICTORY_UPLOAD_QUEUE", value);
+            }
+            let child = cmd.args(["--exact", "host::upq::tests::upload_queue_threshold_reads_the_setting"])
+                .env(EXPECTED, expected)
+                .output().unwrap();
+            let stdout = String::from_utf8_lossy(&child.stdout);
+            let stderr = String::from_utf8_lossy(&child.stderr);
+            assert!(child.status.success() && stdout.contains("1 passed"), "{asked:?}: {stdout}{stderr}");
+        }
     }
 
